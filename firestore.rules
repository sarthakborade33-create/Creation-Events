rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Allow public creation of contact messages, but deny read/update/delete
    match /contactMessages/{message} {
      allow create: if true;
    }

    // 2. Allow public creation of bookings, but deny read/update/delete
    match /bookings/{booking} {
      allow create: if true;
    }

    // 3. Deny all other reads, writes, and database collections access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
